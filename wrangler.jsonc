{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orisadigital",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    // SPA routing: unknown paths serve index.html (replaces a _redirects file,
    // which Workers static assets rejects as an infinite-loop rule).
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
