{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orisadigital",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "orisa.digital", "custom_domain": true },
    { "pattern": "www.orisa.digital", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
